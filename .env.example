# Copie para .env (que não vai para o Git) e preencha. run.sh e run.bat leem o .env.
# No Render, configure as mesmas variáveis em Environment; não envie o .env.

# Conexão com o Postgres. Sem ela, o servidor grava em arquivos na pasta data/ (só para desenvolvimento).
# Supabase: Connect > Session pooler. Troque [YOUR-PASSWORD] pela senha do banco
# (caracteres especiais precisam ser codificados: @ vira %40, # vira %23, / vira %2F).
# Postgres local sem TLS: acrescente ?sslmode=disable no fim.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Chave do HMAC que transforma o IP em um código irreversível (64 caracteres hexadecimais).
# Obrigatória quando DATABASE_URL está definida. Gere com:
#   openssl rand -hex 32
#   ou: python -c "import secrets; print(secrets.token_hex(32))"
# Não troque depois de publicar: a troca faz o site esquecer quem já fez a avaliação.
IP_HMAC_SEGREDO=

# Origens que podem chamar a API pelo navegador, separadas por vírgula, sem barra no final.
# Padrão (se vazia): localhost e 127.0.0.1 nas portas 8080 e 5501.
# Produção: CORS_ORIGENS=https://policarpogustavo.github.io
CORS_ORIGENS=

# Opcionais
# PORT=8080
# DB_POOL=3
# ANALISE_URL=http://127.0.0.1:8081
# CONFIAR_PROXY=1     # atrás de proxy reverso (o Dockerfile já liga)
